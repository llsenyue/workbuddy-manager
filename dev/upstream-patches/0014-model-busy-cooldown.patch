+// TestApplyErrorPolicy14003ModelBusyIsModelScoped 14003「模型繁忙」是**模型侧过载**，
+// 不是账号被限流：必须只冷却 (账号, 模型) 这一对、时长固定 modelBusyCooldown，账号本身
+// 保持健康（换个模型立刻可用）。
+//
+// 回归背景：未分流前 14003 落进 ErrSoftRate 的账号级有界退避（soft_rate 600s 起、
+// softStreak 指数放大到 soft_rate_max，且 modelCooldowns=nil 连切模型都救不了）。
+// 线上实测 6 小时内 13 次冷却有 12 次（92%）由这一条产生 —— 一次模型过载把整池好号
+// 罚成「冷却中」，面板显示「冷却中·N 分钟」而账号其实完全健康。
+func TestApplyErrorPolicy14003ModelBusyIsModelScoped(t *testing.T) {
+	p := pool.New("")
+	p.Add(&auth.Auth{UID: "u1"})
+	h := NewHandler(Config{Pool: p, SoftCooldown: 600 * time.Second})
+
+
+	body := `{"code":14003,"msg":"too many requests","displayMsg":{"zh":"模型繁忙，请换模型或稍后重试"}}`
+	h.applyErrorPolicy("u1", upstream.ErrSoftRate, body, "deepseek-v4.1-flash", nil)
+	st, ok := p.Status("u1")
+	if !ok {
+		t.Fatal("u1 missing")
+	}
+	// 账号级冷却不得发生：账号本身健康，换模型即可继续用。
+	if st.Cooling {
+		t.Fatalf("14003 不应产生账号级冷却（账号是好的）: %+v", st)
+	}
+	if st.SoftStreak != 0 {
+		t.Errorf("14003 不参与 softStreak 退避，soft_streak=%d want 0", st.SoftStreak)
+	}
+	// 只冷却该模型，且时长固定 modelBusyCooldown（不是 600s 基数、不指数放大）。
+	if len(st.RateLimitedModels) != 1 {
+		t.Fatalf("应只有一条模型级台账，实际 %+v", st.RateLimitedModels)
+	}
+	rm := st.RateLimitedModels[0]
+	if rm.Model != "deepseek-v4.1-flash" {
+		t.Errorf("模型级台账应指向被拒模型，实际 %q", rm.Model)
+	}
+	if d := time.Until(rm.Until); d > modelBusyCooldown+time.Second || d < modelBusyCooldown-time.Minute {
+		t.Errorf("模型冷却时长应约等于 modelBusyCooldown(%v)，实际 %v", modelBusyCooldown, d)
+	}
+}
